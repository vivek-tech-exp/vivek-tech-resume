NEXT_PUBLIC_SITE_URL=
# Production canonical URL (e.g. https://tech.footstepswithvivek.com).
# Required for correct SEO: canonical links, Open Graph URLs, sitemap, and robots host.
# If unset on Vercel, the deployment URL is used automatically.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# ntfy — push when someone downloads your resume (PDF or Word routes only)
NTFY_TOPIC=
# Optional: https://ntfy.sh (default) or your self-hosted ntfy base URL
NTFY_URL=
# Optional but recommended: bearer token if your topic uses access control
NTFY_TOKEN=
